rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function isSignedIn() {
      return request.auth != null;
    }
    function legacyAdminEnabled() {
      return !firestore.exists(/databases/(default)/documents/control_policy/enforcement) || firestore.get(/databases/(default)/documents/control_policy/enforcement).data.enabled != true;
    }
    function isAdmin() {
      return legacyAdminEnabled() && isSignedIn() && request.auth.token.firebase.sign_in_provider != 'anonymous' &&
        firestore.exists(/databases/(default)/documents/admins/$(request.auth.uid));
    }
    function allowedStudyFile() {
      return request.resource.size <= 50 * 1024 * 1024 &&
        request.resource.contentType.matches('application/pdf|application/msword|application/vnd\\.openxmlformats-officedocument\\.wordprocessingml\\.document|application/vnd\\.ms-powerpoint|application/vnd\\.openxmlformats-officedocument\\.presentationml\\.presentation|image/(png|jpeg|webp)|text/plain|application/octet-stream');
    }

    match /learning-materials/{adminUid}/{fileName} {
      allow read: if isAdmin();
      allow create, update: if isAdmin() && request.auth.uid == adminUid && allowedStudyFile();
      allow delete: if isAdmin() && request.auth.uid == adminUid;
    }
    // Server-owned immutable notes objects; no public tokens or direct browser access.
    match /managed-notes/{path=**} { allow read, write: if false; }
  }
}
