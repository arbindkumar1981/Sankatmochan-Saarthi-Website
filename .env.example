# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# Public base URL of the Saarthi v3 API. No secrets belong in VITE_* variables.
VITE_SAARTHI_API_URL="https://sankatmochan-saarthi-v3-git-247863708315.asia-south2.run.app"

# Backend runtime settings (server-only)
PORT=8787
SAARTHI_ALLOWED_ORIGIN="http://localhost:3000"

# Firebase Admin credentials for backend token verification + Firestore + Storage.
# Use one of the following:
# 1) GOOGLE_APPLICATION_CREDENTIALS=/absolute/path/service-account.json
# 2) FIREBASE_SERVICE_ACCOUNT_JSON='{"type":"service_account",...}'
FIREBASE_PROJECT_ID=
FIREBASE_STORAGE_BUCKET=
FIREBASE_SERVICE_ACCOUNT_JSON=

# Teacher generator key (preferred variable is GOOGLE_GENAI_API_KEY).
# GEMINI_API_KEY is still supported for compatibility.
GOOGLE_GENAI_API_KEY=
GEMINI_API_KEY=
SAARTHI_GENAI_MODEL="gemini-2.0-flash"

# Optional private Office-to-PDF converter service.
SAARTHI_CONVERTER_URL=

# Optional YouTube live search key for /v1/website/youtube/search.
YOUTUBE_DATA_API_KEY=

# Production Firebase data plane (controlled project)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=sankatmochan-509100
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIRESTORE_DATABASE_ID=(default)
