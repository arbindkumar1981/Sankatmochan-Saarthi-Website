rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Global Safety Net: Default-deny all paths
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }
    function incoming() {
      return request.resource.data;
    }
    function existing() {
      return resource.data;
    }
    function isSignedIn() {
      return request.auth != null;
    }
    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }
    function isAdmin() {
      return isSignedIn() &&
        exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    // Users Collection
    match /users/{userId} {
      allow get: if isOwner(userId) || isAdmin();
      allow list: if isAdmin();
      allow create: if isOwner(userId) && isValidId(userId) &&
        incoming().uid == userId &&
        (incoming().role == 'student' || isAdmin()) &&
        incoming().email is string && incoming().email.size() <= 256;
      allow update: if (isOwner(userId) || isAdmin()) && isValidId(userId) &&
        (isAdmin() || (incoming().role == existing().role && incoming().uid == existing().uid));
      allow delete: if isAdmin();
    }

    // Admins Collection
    match /users/{userId}/saved_materials/{materialId} {
      allow read: if isOwner(userId) && request.auth.token.firebase.sign_in_provider != 'anonymous';
      allow create, update: if isOwner(userId) && request.auth.token.firebase.sign_in_provider != 'anonymous' && isValidId(materialId) &&
        incoming().keys().hasOnly(['id', 'title', 'body', 'curriculum', 'savedAt', 'contentId']) && incoming().id == materialId &&
        incoming().title is string && incoming().title.size() > 0 && incoming().title.size() <= 300 &&
        incoming().body is string && incoming().body.size() <= 200000 &&
        (incoming().body.size() > 0 || ('contentId' in incoming() && isValidId(incoming().contentId))) &&
        (!('contentId' in incoming()) || isValidId(incoming().contentId)) &&
        incoming().curriculum is string && incoming().curriculum.size() <= 1000 &&
        incoming().savedAt is string && incoming().savedAt.size() <= 40;
      allow delete: if false;
    }

    // Admins Collection
    match /admins/{adminUid} {
      // Admin membership is privileged authorization data; do not expose the full list.
      allow get: if isSignedIn() && request.auth.uid == adminUid;
      allow list: if false;
      allow write: if isAdmin();
    }

    // Curriculum Nodes Collection
    match /curriculum_nodes/{nodeId} {
      allow read: if true;
      allow write: if isAdmin() && (isValidId(nodeId) ||
        (nodeId.size() <= 128 && nodeId.matches('^cbse-class (9|10|11|12)-[a-z0-9_\\-]+$')));
    }

    // Learning Contents Collection
    match /learning_contents/{contentId} {
      allow read: if isAdmin() || (isSignedIn() && request.auth.token.firebase.sign_in_provider != 'anonymous' && resource.data.published == true && resource.data.approved == true);
      allow create: if isAdmin() && isValidId(contentId) &&
        incoming().board is string &&
        incoming().classGrade is string &&
        incoming().subjectId is string &&
        incoming().chapterId is string &&
        incoming().contentType is string &&
        incoming().version is number &&
        incoming().approved is bool &&
        incoming().published is bool &&
        ((!('storagePath' in incoming()) && incoming().contentType != 'detailed_notes' && incoming().contentType != 'revision_notes') || incoming().requiresServerReview == true) &&
        (!('requiresServerReview' in incoming()) || incoming().requiresServerReview != true ||
          (incoming().approved == false && incoming().published == false));
      allow update: if isAdmin() && isValidId(contentId) &&
        incoming().board == existing().board &&
        incoming().classGrade == existing().classGrade &&
        incoming().subjectId == existing().subjectId &&
        incoming().chapterId == existing().chapterId &&
        incoming().contentType == existing().contentType &&
        (!('requiresServerReview' in existing()) || incoming().requiresServerReview == existing().requiresServerReview) &&
        (!('requiresServerReview' in existing()) || existing().requiresServerReview != true ||
          ((incoming().approved == false && incoming().published == false) ||
           incoming() == existing()));
      allow delete: if isAdmin() && isValidId(contentId);
    }

    // YouTube Videos Collection
    match /youtube_videos/{videoId} {
      allow read: if (resource.data.published == true && resource.data.approved == true) || isAdmin();
      allow write: if isAdmin() && isValidId(videoId);
    }

    // Evaluation Tests Collection
    match /tests/{testId} {
      // Students read sanitized questions through the authenticated assessment API.
      allow read: if isAdmin();
      allow write: if isAdmin() && isValidId(testId);
    }

    // Test Results Collection
    match /test_results/{resultId} {
      allow get: if isSignedIn() && (resource.data.studentUid == request.auth.uid || isAdmin());
      allow list: if isSignedIn() && (resource.data.studentUid == request.auth.uid || isAdmin());
      allow create: if isAdmin();
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    // Mistakes Book Collection
    match /mistakes/{mistakeId} {
      allow get: if isSignedIn() && (resource.data.studentUid == request.auth.uid || isAdmin());
      allow list: if isSignedIn() && (resource.data.studentUid == request.auth.uid || isAdmin());
      allow create: if isAdmin() && isValidId(mistakeId);
      allow update: if isAdmin() || (isSignedIn() && resource.data.studentUid == request.auth.uid &&
        incoming().diff(existing()).affectedKeys().hasOnly(['masteryStatus', 'reviewedAt']) &&
        incoming().masteryStatus == 'reviewed' && incoming().reviewedAt is string && incoming().reviewedAt.size() <= 40);
      allow delete: if isAdmin();
    }

    // Motivational Notices & Circulars
    match /notices/{noticeId} {
      allow read: if resource.data.active == true || isAdmin();
      allow write: if isAdmin() && isValidId(noticeId);
    }

    // Contact Enquiries Collection
    match /enquiries/{enquiryId} {
      allow get, list: if isAdmin();
      allow create: if isValidId(enquiryId) &&
        incoming().name is string && incoming().name.size() <= 128 &&
        incoming().email is string && incoming().email.size() <= 256 &&
        incoming().message is string && incoming().message.size() <= 4096;
      allow update, delete: if isAdmin();
    }
  }
}
